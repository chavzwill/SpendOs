# Copy to .env.spendos.local in the isolated installation checkout.
# Keep that populated file untracked. No real credentials belong in this example.
SPENDOS_TENANT_ID=total-tools
SPENDOS_INGEST_URL=
SPENDOS_API_KEY=
SPENDOS_OUTBOX_BATCH=25
SPENDOS_OUTBOX_MAX_ATTEMPTS=8
POS_SETTINGS_ENCRYPTION_KEY=
# First boot of the new, isolated local database only. Remove password/PIN
# from the environment after successful bootstrap and recreate the container.
POS_BOOTSTRAP_ADMIN_USER=admin
POS_BOOTSTRAP_ADMIN_PASSWORD=
POS_BOOTSTRAP_ADMIN_PIN=
